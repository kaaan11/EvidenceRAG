# Copy to .env and uncomment the values you want to change.
# Variables already set in the environment take precedence over this file.
# ACCESS_PROFILE=local  # Only direct loopback is supported; shared/public is rejected.

# EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_PASSAGE_PREFIX="passage: "
# LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
# EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# LLM_MODEL_REVISION=989aa7980e4cf806f80c7fef2b1adb7bc71aa306
# INGESTION_VERSION=1
# CHUNKER_STRATEGY=legacy_character
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# TOP_K=5
# RELEVANCE_THRESHOLD=0.80
# MAX_NEW_TOKENS=256
# MAX_UPLOAD_MB=20
# MAX_UPLOAD_BYTES=20971520  # Optional: overrides MAX_UPLOAD_MB (MiB).
# MAX_HTTP_BODY_BYTES=21037056
# MAX_JSON_BODY_BYTES=32768
# MAX_MULTIPART_HEADER_BYTES=8192
# MAX_FILENAME_BYTES=512
# MAX_QUESTION_CHARS=4000
# MAX_PDF_PAGES=500
# MAX_TEXT_CHARS=2000000
# MAX_DOCUMENT_CHUNKS=2000
# MAX_STORE_CHUNKS=20000
# MAX_STORE_TEXT_BYTES=67108864
# MAX_ACTIVE_HEAVY_JOBS=1
# MAX_WAITING_HEAVY_JOBS=2
# ASK_QUEUE_CAPACITY=2
# INDEX_QUEUE_CAPACITY=2
# MODEL_QUEUE_CAPACITY=2
# HEAVY_WAIT_SECONDS=30
# PRELOAD_MODELS=false
# TORCH_NUM_THREADS=4  # Optional; omit to preserve host thread defaults.
# INDEX_DIR=data/index
